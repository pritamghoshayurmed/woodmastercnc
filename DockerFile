# =============================================================================
# Woodmaster CNC Assistant – Production Dockerfile (Multi-Stage)
# =============================================================================
# Stage 1 : builder   – installs ALL build-time deps, compiles packages
# Stage 2 : runtime   – lean image, only what the app needs to run
#
# Target image: python:3.11-slim-bookworm  (~60 MB base)
# Build cache:  pip cache mounted via BuildKit (never written to image layers)
# Security:     non-root user, read-only /opt/venv
# Runtime size: builder stage is discarded entirely
# =============================================================================

# ── Stage 1: builder ─────────────────────────────────────────────────────────
FROM python:3.11-slim-bookworm AS builder

# Avoid interactive apt prompts
ENV DEBIAN_FRONTEND=noninteractive

WORKDIR /build

# Install only the packages needed to *compile* Python wheels.
# All of these are discarded in the final image.
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        gcc \
        g++ \
        libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Isolated virtual environment – keeps the runtime layer clean
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Upgrade pip + wheel first (cached separately so code changes don't bust this)
COPY requirements.txt .

# --mount=type=cache keeps the pip download cache OUTSIDE the image layer.
# Re-builds reuse the cache without blowing up the image size.
# The --no-deps flag is intentionally NOT set; we need the full dep tree.
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --upgrade pip wheel && \
    pip install --no-cache-dir -r requirements.txt

# ── Stage 2: runtime ─────────────────────────────────────────────────────────
FROM python:3.11-slim-bookworm AS runtime

LABEL maintainer="Woodmaster CNC <dev@woodmastercnc.in>" \
      org.opencontainers.image.title="Woodmaster CNC Assistant" \
      org.opencontainers.image.description="WhatsApp / Messenger RAG chatbot for Woodmaster CNC" \
      org.opencontainers.image.base.name="python:3.11-slim-bookworm"

ENV DEBIAN_FRONTEND=noninteractive

# ── Runtime system libraries ──────────────────────────────────────────────────
# libgomp1  : required by faiss-cpu and numpy at runtime (OpenMP threading)
# libgcc-s1 : transitive dep of libgomp1 (usually pre-installed on slim)
# ca-certificates : needed for HTTPS calls to Sarvam / Gemini APIs
RUN apt-get update && apt-get install -y --no-install-recommends \
        libgomp1 \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# ── Python env hardening ──────────────────────────────────────────────────────
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONFAULTHANDLER=1 \
    PYTHONHASHSEED=random \
    PATH="/opt/venv/bin:$PATH" \
    # Uvicorn / FastAPI tunables (override via docker run -e or compose)
    PORT=8000 \
    WEB_CONCURRENCY=2 \
    UVICORN_WORKERS=2

# ── Non-root user (security hardening) ───────────────────────────────────────
# Create the user BEFORE copying files so chown is a single no-cost metadata op
RUN groupadd --gid 1001 appgroup && \
    useradd  --uid 1001 --gid appgroup \
             --no-create-home --shell /sbin/nologin \
             appuser

WORKDIR /app

# ── Copy venv from builder (no pip, no compiler, no headers) ─────────────────
COPY --from=builder --chown=appuser:appgroup /opt/venv /opt/venv

# ── Copy only the application source (see .dockerignore for exclusions) ───────
COPY --chown=appuser:appgroup src/            ./src/
COPY --chown=appuser:appgroup server.py       ./server.py
COPY --chown=appuser:appgroup frontend.html   ./frontend.html

# ── Runtime directories (writable by appuser) ────────────────────────────────
# data/images  : product images served as static files
# artifacts/   : FAISS index, session files, flow state
RUN mkdir -p \
        data/images \
        artifacts/flow_state \
        artifacts/sessions_private \
    && chown -R appuser:appgroup \
        data \
        artifacts

# ── Drop to non-root ─────────────────────────────────────────────────────────
USER appuser

# ── Expose & healthcheck ──────────────────────────────────────────────────────
EXPOSE 8000

# Render / ECS / K8s liveness probe support.
# /health returns {"status":"ok"} immediately; /ready checks RAG init.
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD python -c \
        "import urllib.request, sys; \
         r = urllib.request.urlopen('http://localhost:${PORT}/health', timeout=8); \
         sys.exit(0 if r.status == 200 else 1)"

# ── Entrypoint ────────────────────────────────────────────────────────────────
# WEB_CONCURRENCY / UVICORN_WORKERS can be overridden at deploy time.
# --no-access-log keeps logs clean (FastAPI already logs what matters).
# --timeout-keep-alive 75 matches Render/ALB idle timeout defaults.
CMD uvicorn server:app \
        --host 0.0.0.0 \
        --port "${PORT}" \
        --workers "${UVICORN_WORKERS}" \
        --no-access-log \
        --timeout-keep-alive 75
